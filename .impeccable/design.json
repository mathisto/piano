  "narrative": {
    "northStar": "The DDR Cabinet at Night",
    "overview": "A dark, cool-blue room with lit lane panels, a bright receptor line over the keys, and judgement words in heavy condensed italic. The arcade lives on the stage (highway, receptor, sparks, the combo slam). The notation does not: the grand staff is the scoreboard, set in near-white Bravura on a flat panel, and it ignites only to report state (awaited note, hit grade, miss). The shell around the stage is plain web controls (segmented switch, sliders, buttons, a table).\n\nThe player sits 1-2 m from the screen with busy hands, so state is carried by word, shape, and hue together, never hue alone. Hands differ by hue, by lightness, and by fill style. Density is moderate and fixed: a 56px top bar, a stage, a docked transport.",
    "keyCharacteristics": [
      "Cool navy ground with one warm voice (the lamp amber) for focus, selection, primary action, cursor and combo.",
      "Heavy italic condensed display type for everything that is announced; a quiet grotesk for everything that is read.",
      "Glow is a state signal on the staff and stage only, not decoration on chrome.",
      "Desktop only, minimum 1024px; below that a full-screen notice replaces the app."
    ],
    "rules": [
      {
        "name": "The Calm Staff Rule",
        "body": "Notation is Ink on Panel. Colour appears on a staff glyph only as state: lamp for awaited, grade colour for a hit, miss red for a miss; it then decays to Ink Faint as \"played\".",
        "section": "colors"
      },
      {
        "name": "The One Lamp Rule",
        "body": "Amber means \"here, now, yours\": focus, selection, the next action. It is never used for a judgement grade other than the Good step.",
        "section": "colors"
      },
      {
        "name": "The Word And Shape Rule",
        "body": "A judgement colour never stands alone; it ships with its word (or letter grade) and, on the staff, a position or mark.",
        "section": "colors"
      },
      {
        "name": "The Announce Versus Read Rule",
        "body": "Display italic is for what is announced (score, grade, judgement, headings, primary big actions). Anything the player must read in running sentences is Hanken.",
        "section": "typography"
      },
      {
        "name": "The Glow Means State Rule",
        "body": "A glow is allowed only on an element reporting live state in its own colour. Chrome (buttons, panels, headings) does not glow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep notation Ink on Panel and let it ignite only for state.",
      "**Do** pair every judgement colour with a word, letter or position.",
      "**Do** differentiate hands by hue, fill style (solid vs. outlined tint) and lane edge.",
      "**Do** use Lamp (#ffc83d) for focus, selection and the primary action, and the 2px/2px Lamp focus ring everywhere.",
      "**Do** use Barlow Condensed 800 italic for announced values and Hanken for reading text; keep numerals tabular.",
      "**Do** mirror any new colour in `src/palette.ts` if Pixi draws it.",
      "**Do** respect `prefers-reduced-motion` (animations collapse to ~0ms)."
    ],
    "donts": [
      "**Don't** add synthwave sun, perspective grid, or glow on chrome.",
      "**Don't** colour notation permanently; colour is a transient state.",
      "**Don't** set text dimmer than Ink Faint (#8a8fbd) on Panel, or smaller than 11px.",
      "**Don't** design below 1024px; the narrow notice is the whole responsive story.",
      "**Don't** introduce a second warm accent beside the lamp."
    ]
  }
}